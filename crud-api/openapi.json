{   "openapi": "3.0.3",
    "info": {
        "title": "Tasl API",
        "version": "1.0.0"
    },
    "paths": {
        "/": {
            "get": {
                "responses": {
                    "200": {
                        "description": "returns API information"
                    }
                }
            }
        },
        "/health": {
            "get": {
                "responses": {
                    "200": {
                        "description": "returns the API health status"
                    }
                }
            }
        },
        "/tasks": {
            "get" : {
                "responses" : {
                    "200": {
                        "description" : "returns an array of task objects"
                    }
                }
            },
            "post": {
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["title"],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "creates and returns a task object"
                    },
                    "400": {
                        "description": "missing or invalid title"
                    }
                }
            }
        },
        "/tasks/{id}": {
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "schema": {
                        "type": "integer"
                    }
                }
            ],
            "get": {
                "responses": {
                    "200": {
                        "description": "returns a task object"
                    },
                    "404": {
                        "description": "task not found"
                    }
                }
            },
            "put": {
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "anyOf": [
                                    {"required": ["title"]},
                                    {"required": ["done"]}
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "done": {
                                        "type": "boolean"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "updates and returns a task object"
                    },
                    "400": {
                        "description": "empty body, missing title or done, or invalid field value"
                    },
                    "404": {
                        "description": "task not found"
                    }
                }
            },
            "delete": {
                "responses": {
                    "204": {
                        "description": "deletes a task"
                    },
                    "404": {
                        "description": "task not found"
                    }
                }
            }
        }
    }
}
